# Copy this file to .env (which git ignores) and fill in the key. Never commit .env.

# Anthropic API key for the tutor's hints. Without it the tutor uses its fixed hints.
ANTHROPIC_API_KEY=

# Optional. Model that writes the hints (default: claude-opus-5-5).
# HINT_MODEL=claude-haiku-5-5

# Optional. Milliseconds to wait for a hint before using the fixed one (default: 5000).
# HINT_TIMEOUT_MS=5000
